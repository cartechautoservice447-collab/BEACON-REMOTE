  "validPayloads": [
    {
      "name": "move-center",
      "json": "{\"type\":\"pointer.move.abs\",\"x\":0.5,\"y\":0.5}",
      "expectedType": "pointer.move.abs"
    },
    {
      "name": "move-boundaries",
      "json": "{\"type\":\"pointer.move.abs\",\"x\":0,\"y\":1}",
      "expectedType": "pointer.move.abs"
    },
    {
      "name": "move-out-of-order-discriminator",
      "json": "{\"x\":0.25,\"y\":0.75,\"type\":\"pointer.move.abs\"}",
      "expectedType": "pointer.move.abs"
    },
    {
      "name": "button-left-down",
      "json": "{\"type\":\"pointer.button\",\"button\":\"left\",\"action\":\"down\",\"x\":0.1,\"y\":0.9}",
      "expectedType": "pointer.button"
    },
    {
      "name": "button-right-up",
      "json": "{\"type\":\"pointer.button\",\"button\":\"right\",\"action\":\"up\",\"x\":0.95,\"y\":0.05}",
      "expectedType": "pointer.button"
    },
    {
      "name": "button-middle-down",
      "json": "{\"type\":\"pointer.button\",\"button\":\"middle\",\"action\":\"down\",\"x\":0.5,\"y\":0.5}",
      "expectedType": "pointer.button"
    },
    {
      "name": "wheel-positive-vertical",
      "json": "{\"type\":\"pointer.wheel\",\"dx\":0,\"dy\":42.5}",
      "expectedType": "pointer.wheel"
    },
    {
      "name": "wheel-negative-vertical",
      "json": "{\"type\":\"pointer.wheel\",\"dx\":0,\"dy\":-35.25}",
      "expectedType": "pointer.wheel"
    },
    {
      "name": "wheel-horizontal-fractional",
      "json": "{\"type\":\"pointer.wheel\",\"dx\":-0.25,\"dy\":0.125}",
      "expectedType": "pointer.wheel"
    },
    {
      "name": "key-normal-down",
      "json": "{\"type\":\"key\",\"code\":\"KeyA\",\"action\":\"down\"}",
      "expectedType": "key"
    },
    {
      "name": "key-modifier-up",
      "json": "{\"type\":\"key\",\"code\":\"ControlLeft\",\"action\":\"up\"}",
      "expectedType": "key"
    },
    {
      "name": "key-lock-down",
      "json": "{\"type\":\"key\",\"code\":\"CapsLock\",\"action\":\"down\"}",
      "expectedType": "key"
    },
    {
      "name": "input-reset",
      "json": "{\"type\":\"input.reset\"}",
      "expectedType": "input.reset"
    }
  ],
